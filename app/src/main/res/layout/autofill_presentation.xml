<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_autofill_presentation">

    <TextView
        android:id="@+id/autofill_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CardVault"
        android:textColor="#FFF7F4"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/autofill_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Érintsd meg az azonosításhoz"
        android:textColor="#D9C8C3"
        android:textSize="12sp"
        android:layout_marginTop="3dp"
        android:maxLines="1" />
</LinearLayout>
